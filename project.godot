[layer_names]

2d_physics/layer_1="Player Collisions"
2d_navigation/layer_1="Walls"
2d_physics/layer_2="Enemy Collisions"
2d_physics/layer_3="Damage Collision (Enemies)"
2d_physics/layer_4="Damage Collision (Player)"
2d_physics/layer_5="Void Collision"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=0
